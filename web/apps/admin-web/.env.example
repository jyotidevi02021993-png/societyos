# Gateway base URL (the gateway runs on 8000 on this machine because 8080 is taken)
API_BASE_URL=http://localhost:8000
# Session store: auto (Redis, fall back to in-memory outside production) | redis | memory
SESSION_STORE=auto
REDIS_URL=redis://localhost:6379
# Secure cookie flag; defaults to true when NODE_ENV=production
# SESSION_COOKIE_SECURE=false
# Admin session lifetime (sliding), default 12 h
# SESSION_TTL_SECONDS=43200
# Force TOTP enrolment before the portal opens (default true)
# ADMIN_REQUIRE_MFA=true
